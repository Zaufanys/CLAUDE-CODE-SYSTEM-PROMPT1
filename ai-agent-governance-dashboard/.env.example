# Copy to `.env` and adjust. Every value is optional — the service runs with
# zero configuration and generates secrets on first start.

# HTTP server
PORT=4175
HOST=0.0.0.0

# SQLite database file (created automatically)
DB_PATH=./data/governance.db

# Reviewer admin account. If ADMIN_PASSWORD is unset on first run, a random
# password is generated and printed to the console exactly once.
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-please

# Ingestion API key for agents posting traces. If unset on first run, a random
# key is generated and printed once.
# INGEST_API_KEY=agk_your_key_here

# Session lifetime in milliseconds (default 12h)
SESSION_TTL_MS=43200000

# Seed example traces into an empty database on first run (1 = yes, 0 = no)
SEED_SAMPLES=1
